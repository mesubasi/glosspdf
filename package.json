{
  "name": "glosspdf",
  "version": "1.0.8",
  "description": "Sleek, modern and open-source desktop PDF workstation",
  "author": "GlossPDF Team",
  "license": "GPL-3.0-or-later",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "mobile:dev": "vite --config vite.mobile.config.ts",
    "mobile:build": "tsc && vite build --config vite.mobile.config.ts",
    "mobile:sync": "npm run mobile:build && cap sync android",
    "release": "npm version patch -m \"chore: release v%s\" && git push --follow-tags"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capawesome/capacitor-file-picker": "^8.1.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "clsx": "^2.1.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.359.0",
    "pdf-lib": "^1.17.1",
    "pdf-lib-encrypt": "^1.0.3",
    "pdfjs-dist": "3.11.174",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^20.11.28",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.5",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.4",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "io.github.glosspdf",
    "productName": "GlossPDF",
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "mesubasi",
      "repo": "glosspdf"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!node_modules"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "GlossPDF-${version}-portable.${ext}"
    },
    "nsis": {
      "artifactName": "GlossPDF-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "maintainer": "GlossPDF <88106043+mesubasi@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "GlossPDF${arch}"
    }
  }
}
